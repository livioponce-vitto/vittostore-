# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vittostore

# Node environment
NODE_ENV=development
PORT=3000

# Vault (Secrets management)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=hvs.xxxxx
VAULT_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Webhook security
WEBHOOK_SECRET=your-webhook-secret-min-32-chars

# Banco Chile API (Payment tokenization)
BANCO_CHILE_API_URL=https://api.bancochile.cl/v1
BANCO_CHILE_API_KEY=your-api-key

# SII API (Factura submission)
SII_API_URL=https://www.sii.cl/api
SII_USERNAME=username
SII_PASSWORD=password

# Logging
LOG_LEVEL=info

# Debug mode
DEBUG=false
