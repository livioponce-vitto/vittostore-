# Docker Development Environment Template
# Copy to .env and customize for your local environment

# Application
NODE_ENV=development
PORT=3000

# PostgreSQL
POSTGRES_DB=vittostore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_URL=postgresql://postgres:postgres@postgres:5432/vittostore

# Redis
REDIS_URL=redis://redis:6379

# Banco Chile API (configure with your credentials)
BANCO_CHILE_API_URL=https://api.bancochile.cl
BANCO_CHILE_API_KEY=your_api_key_here
BANCO_CHILE_RUT=your_rut_here

# Oraculo Services
ORACULO_SERVICE_URL=http://localhost:4000
